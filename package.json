{
  "name": "deck-engine",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @deckio/deck-engine",
    "build": "npm run build -w @deckio/deck-engine --if-present",
    "version:deck-engine": "npm run version:sync -w @deckio/deck-engine",
    "test": "npx vitest run",
    "test:exports": "playwright test --config playwright.exports.config.mjs",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
